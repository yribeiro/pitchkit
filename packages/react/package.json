{
  "name": "@pitchkit/react",
  "version": "0.4.1",
  "description": "React football (soccer) visualisation library — declarative <Pitch> + layer components for shot maps, pass networks and heatmaps. TypeScript, responsive by default, Next.js ready.",
  "license": "MIT",
  "author": "Yohahn Ribeiro",
  "homepage": "https://github.com/yribeiro/pitchkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yribeiro/pitchkit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/yribeiro/pitchkit/issues"
  },
  "keywords": [
    "football",
    "soccer",
    "pitch",
    "visualization",
    "dataviz",
    "analytics",
    "mplsoccer",
    "statsbomb",
    "react",
    "nextjs",
    "typescript",
    "charting",
    "charts",
    "data-visualization",
    "visualisation",
    "football-pitch",
    "soccer-analytics",
    "shot-map",
    "pass-network",
    "heatmap"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pitchkit": "./bin/pitchkit.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skills"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-use-client.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pitchkit/core": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "happy-dom": "^20.10.6",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
