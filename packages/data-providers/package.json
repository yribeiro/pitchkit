{
  "name": "@pitchkit/data-providers",
  "version": "0.4.0",
  "description": "Convenience loaders for open football data (StatsBomb events + 360, SkillCorner tracking, Wyscout events) — raw files in, typed events out, ready for PitchKit.",
  "license": "MIT",
  "author": "Yohahn Ribeiro",
  "homepage": "https://github.com/yribeiro/pitchkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yribeiro/pitchkit.git",
    "directory": "packages/data-providers"
  },
  "bugs": {
    "url": "https://github.com/yribeiro/pitchkit/issues"
  },
  "keywords": [
    "football",
    "soccer",
    "statsbomb",
    "skillcorner",
    "wyscout",
    "tracking-data",
    "open-data",
    "event-data",
    "analytics",
    "dataviz",
    "pitchkit",
    "kloppy",
    "typescript",
    "football-data",
    "soccer-analytics",
    "sports-data"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./statsbomb": {
      "types": "./dist/statsbomb/index.d.ts",
      "import": "./dist/statsbomb/index.js"
    },
    "./skillcorner": {
      "types": "./dist/skillcorner/index.d.ts",
      "import": "./dist/skillcorner/index.js"
    },
    "./wyscout": {
      "types": "./dist/wyscout/index.d.ts",
      "import": "./dist/wyscout/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
