{
  "name": "pitchkit",
  "private": true,
  "version": "0.0.0",
  "description": "React-first football pitch visualisation for the web — mplsoccer's feature set, built for React and Next.js instead of matplotlib.",
  "license": "MIT",
  "author": "Yohahn Ribeiro",
  "homepage": "https://github.com/yribeiro/pitchkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yribeiro/pitchkit.git"
  },
  "bugs": {
    "url": "https://github.com/yribeiro/pitchkit/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react-hooks": "^7",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5"
  }
}
