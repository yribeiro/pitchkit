{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "description": "PitchKit docs site: Next.js App Router + Fumadocs, with live @pitchkit/react examples.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-examples-registry.mjs && node scripts/generate-api-docs.mjs",
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build",
    "start": "next start",
    "lint": "npm run generate && eslint .",
    "typecheck": "npm run generate && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@pitchkit/core": "*",
    "@pitchkit/react": "*",
    "@vercel/analytics": "^2.0.1",
    "fumadocs-core": "^16",
    "fumadocs-mdx": "^15",
    "fumadocs-ui": "^16",
    "lz-string": "^1.5.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5"
  }
}
