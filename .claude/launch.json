{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "core-examples",
      "runtimeExecutable": "wsl.exe",
      "runtimeArgs": [
        "-e",
        "bash",
        "-lic",
        "cd ~/random/pitchkit/packages/core && python3 -m http.server 4321"
      ],
      "port": 4321
    },
    {
      "name": "react-vite-example",
      "runtimeExecutable": "wsl.exe",
      "runtimeArgs": [
        "-e",
        "bash",
        "-lic",
        "cd ~/random/pitchkit/examples/react-vite && npm run dev -- --host"
      ],
      "port": 5173
    },
    {
      "name": "react-nextjs-example",
      "runtimeExecutable": "wsl.exe",
      "runtimeArgs": [
        "-e",
        "bash",
        "-lic",
        "cd ~/random/pitchkit/examples/react-nextjs && npm run dev -- --hostname 0.0.0.0"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "docs-example",
      "runtimeExecutable": "wsl.exe",
      "runtimeArgs": [
        "-e",
        "bash",
        "-lic",
        "cd ~/random/pitchkit/apps/docs && npm run dev -- --hostname 0.0.0.0 --port 3001"
      ],
      "port": 3001,
      "autoPort": false
    }
  ]
}
